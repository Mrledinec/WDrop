  "components": {
    "schemas": {
      "Decision": {
        "properties": {
          "accept": {
            "type": "boolean",
            "title": "Accept"
          }
        },
        "type": "object",
        "required": [
          "accept"
        ],
        "title": "Decision"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Metadata": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Size"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "name",
          "size",
          "sha256"
        ],
        "title": "Metadata"
      },
      "PairRequest": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 100,
            "minLength": 20,
            "title": "Token"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "token",
          "name"
        ],
        "title": "PairRequest"
      },
      "Paired": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "token": {
            "type": "string",
            "title": "Token"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "token",
          "name"
        ],
        "title": "Paired"
      },
      "Receipt": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "Receipt"
      },
      "TransferStatus": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "size": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Size"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "direction": {
            "type": "string",
            "enum": [
              "upload",
              "download"
            ],
            "title": "Direction"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "transferring",
              "completed",
              "rejected",
              "expired",
              "failed"
            ],
            "title": "State"
          },
          "received": {
            "type": "integer",
            "title": "Received"
          },
          "seconds_left": {
            "type": "integer",
            "title": "Seconds Left"
          }
        },
        "type": "object",
        "required": [
          "name",
          "size",
          "sha256",
          "id",
          "direction",
          "state",
          "received",
          "seconds_left"
        ],
        "title": "TransferStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
